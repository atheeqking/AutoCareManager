# PostgreSQL values used by docker compose and the backend postgres profile
POSTGRES_DB=autocare_manager
POSTGRES_USER=autocare
POSTGRES_PASSWORD=password
POSTGRES_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/autocare_manager
DB_USERNAME=autocare
DB_PASSWORD=password

# Frontend development API base URL
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_BACKEND_ORIGIN=http://localhost:8080
VITE_GOOGLE_LOGIN_ENABLED=false

# Authentication. JWT_SECRET is required; the API will not start without a 32+ character value.
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
JWT_EXPIRATION=3600
FRONTEND_URL=http://localhost:5173

# Demo workshop logins (owner/manager/employee@autocare.com, password "password").
# Keep false anywhere other than a local development machine.
DEMO_ACCOUNTS_ENABLED=true

# Optional Google OAuth2. Activate the backend `google` Spring profile only when both are set.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
